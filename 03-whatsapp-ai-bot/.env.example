# Meta for Developers > your app > WhatsApp > API Setup.
# The temporary token lasts 24 hours; use a System User token for anything longer.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; type the same one when registering the webhook.
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App secret. Signs every webhook.
WHATSAPP_APP_SECRET=

# console.anthropic.com > API keys.
ANTHROPIC_API_KEY=
# Optional: defaults to claude-opus-5-5.
CLAUDE_MODEL=

# Login for /admin.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Set by docker-compose. Leave unset with `npm run dev` to keep conversations in memory.
# DATABASE_URL=postgres://bot:bot@localhost:5432/bot

# Keyless run: no Meta or Anthropic account.
# `docker compose -f docker-compose.keyless.yml up --build -d --wait` needs no .env;
# it sets these itself. They matter only to run the bot by hand against the same stand-ins.
# Which model answers: "claude" (default) or "ollama" (a local open-source model).
# LLM_PROVIDER=ollama
# Optional: defaults to qwen2.5:1.5b.
# OLLAMA_MODEL=qwen2.5:1.5b
# Optional: defaults to http://localhost:11434.
# OLLAMA_URL=http://localhost:11434
# Send through the local Graph mock instead of graph.facebook.com.
# WHATSAPP_GRAPH_URL=http://localhost:3100

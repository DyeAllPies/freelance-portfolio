# Keyless run: stand-ins only. None of these values is a credential; they only
# need to match between the app and the local mock (npm run mock).
APP_URL=http://localhost:3000

# Supabase: `npx supabase start` prints both for the local stack.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago stand-in.
MP_ACCESS_TOKEN=TEST-keyless
MP_WEBHOOK_SECRET=keyless-mp-secret

# Stripe stand-in.
STRIPE_SECRET_KEY=sk_test_keyless
STRIPE_WEBHOOK_SECRET=whsec_keyless

# Point both providers at the local mock.
MP_API_BASE=http://localhost:4010
STRIPE_API_BASE=http://localhost:4010
MOCK_PORT=4010

# Public URL of this app. Mercado Pago must reach it for webhooks, so in
# development point it at a tunnel (cloudflared or ngrok) to localhost:3000.
APP_URL=http://localhost:3000

# Supabase: `npx supabase start` prints both for the local stack.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago, test credentials: Suas integrações > your app > Credenciais de teste.
MP_ACCESS_TOKEN=TEST-
# Suas integrações > your app > Webhooks > Assinatura secreta.
MP_WEBHOOK_SECRET=

# Stripe, test mode: Developers > API keys.
STRIPE_SECRET_KEY=sk_test_
# Printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=whsec_

# Optional: point at a local stand-in instead of the provider; leave unset for the real API.
# MP_API_BASE=
# Optional: point at a local stand-in instead of the provider; leave unset for the real API.
# STRIPE_API_BASE=

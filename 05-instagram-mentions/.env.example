# Meta for Developers > your app > Webhooks > Instagram > Edit subscription.
# Any string you choose; type the same one when registering the webhook.
INSTAGRAM_VERIFY_TOKEN=
# App settings > Basic > App secret. Signs every webhook.
INSTAGRAM_APP_SECRET=
# A Page or System User token for the Page linked to the Instagram professional
# account, with instagram_basic, instagram_manage_comments and
# pages_read_engagement. Used to read the mention and to reply to it.
INSTAGRAM_ACCESS_TOKEN=

# Login for /admin.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Optional. Leave unset to use the real https://graph.facebook.com.
# Pointing it at the local Graph mock (npm run dev:mock) runs the whole flow
# with no Meta app, for example http://localhost:4010
# GRAPH_BASE_URL=
# Optional: defaults to v21.0.
# GRAPH_API_VERSION=

# Set by docker-compose. Leave unset with `npm run dev` to keep mentions in memory.
# DATABASE_URL=postgres://mentions:mentions@localhost:5432/mentions

# Optional: defaults to 3000.
# PORT=3000

# Keyless run (no Meta app): `docker compose up` needs no .env. These are the
# local test defaults it uses; they are not secrets.
#   INSTAGRAM_VERIFY_TOKEN=local-verify
#   INSTAGRAM_APP_SECRET=mock-app-secret
#   INSTAGRAM_ACCESS_TOKEN=mock-token
#   ADMIN_USER=admin
#   ADMIN_PASSWORD=local-pw
#   GRAPH_BASE_URL=http://mock:4010
# For a keyed run set real values above, GRAPH_BASE_URL=https://graph.facebook.com,
# and start it with `docker compose up app db`. The mock container still starts
# (depends_on) but nothing calls it: GRAPH_BASE_URL points the app at Meta.
